<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="14.0" styleClass="cineplanet-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.LoginController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label styleClass="cineplanet-header" text="CinePlanet" />
        <Label text="Inicia sesión para continuar" />
        <VBox spacing="4.0">
            <children>
                <Label text="Usuario" />
                <TextField fx:id="txtUsuario" promptText="Usuario" />
            </children>
        </VBox>
        <VBox spacing="4.0">
            <children>
                <Label text="Clave" />
                <PasswordField fx:id="txtClave" promptText="Clave" />
            </children>
        </VBox>
        <Label fx:id="lblError" maxWidth="1.7976931348623157E308" style="-fx-text-fill: red;" text="" wrapText="true" />
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button defaultButton="true" mnemonicParsing="false" onAction="#ingresar" styleClass="btn, btn-primary" text="Ingresar" />
                <Button mnemonicParsing="false" onAction="#cerrar" styleClass="btn, btn-danger" text="Cerrar" />
            </children>
        </HBox>
    </children>
</VBox>
